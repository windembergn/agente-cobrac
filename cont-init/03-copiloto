#!/command/with-contenv sh
# Copiloto — autoconfiguracao no boot (roda depois da base popular /opt/data).
set -e
DATA=/opt/data
CFG="$DATA/config.yaml"
cd "$DATA" 2>/dev/null || true
mkdir -p "$DATA/whatsapp"

if [ ! -f "$DATA/.copiloto_configured" ]; then
  H=$(/opt/hermes/.venv/bin/python -c "from plugins.dashboard_auth.basic import hash_password; print('H4SH='+hash_password('${DASH_PASS:-TroqueASenha2026}'))" 2>/dev/null | sed -n 's/^H4SH=//p' | tail -1)
  S=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
  cat > "$CFG" <<CFG
model:
  provider: openai-api
  default: gpt-5
stt:
  enabled: true
  provider: openai
  openai:
    model: whisper-1
approvals:
  mode: smart
dashboard:
  basic_auth:
    username: ${DASH_USER:-admin}
    password_hash: "$H"
    secret: "$S"
plugins:
  enabled:
  - dashboard_auth/basic
platforms:
  whatsapp:
    enabled: true
    dm_policy: disabled
    group_policy: allowlist
    group_allow_from: []
display:
  tool_progress: 'off'
  show_reasoning: false
  interim_assistant_messages: false
  memory_notifications: 'off'
  credits_notices: false
  turn_completion_explainer: false
  # Audio nao passa pelo debounce, entao cada audio abre um turno e o proximo
  # interromperia o anterior, gerando "Interrupting current task" em ingles no
  # grupo. Em steer a mensagem nova entra no turno em andamento, e com o ack
  # desligado isso acontece em silencio. O modo interrupt (default) nao tem
  # knob para silenciar esse aviso.
  busy_input_mode: steer
  busy_steer_ack_enabled: false
  platforms:
    whatsapp:
      tool_progress: 'off'
      show_reasoning: false
      interim_assistant_messages: false
      long_running_notifications: false
      busy_steer_ack_enabled: false
      busy_ack_detail: false
      memory_notifications: 'off'
compression:
  threshold: 0.7
cron:
  wrap_response: false

# Dicas de primeira vez ("First-time tip — ... /busy queue ...") ja marcadas como
# vistas: sao one-time, mas a primeira apareceria no grupo do cirurgiao.
onboarding:
  seen:
    busy_input_prompt: true
    tool_progress_prompt: true
    openclaw_residue_cleanup: true
    profile_build_offered: true
CFG
  [ -f /opt/copiloto/SOUL.md ] && cp /opt/copiloto/SOUL.md "$DATA/SOUL.md" || true
  touch "$DATA/.copiloto_configured"
fi

# Aplica os patches do bridge (idempotente)
BR=$(find "$DATA/scripts" -name bridge.js 2>/dev/null | head -1)
# O patch e' idempotente, entao um bridge ja patchado no volume ficaria preso na
# versao antiga ao atualizar a imagem. Como o bridge.js da imagem ja vem patchado
# do build, sincroniza o volume com ele (valida antes de trocar; se o node nao
# aprovar, mantem o que esta la e deixa o patch abaixo cuidar).
#
# Sincroniza a PASTA INTEIRA, nao so o bridge.js: o bridge e' dividido em
# modulos (bridge_helpers.js, allowlist.js, ...) e copiar so o principal
# deixa um bridge novo chamando um helper velho — o que quebra o WhatsApp
# no boot com "does not provide an export named ...". node_modules fica de
# fora (e' pesado e o proprio Hermes reinstala quando o package.json muda).
IMG_DIR=/opt/hermes/scripts/whatsapp-bridge
IMG_BR="$IMG_DIR/bridge.js"
if [ -n "$BR" ] && [ -f "$IMG_BR" ] && node --check "$IMG_BR" >/dev/null 2>&1; then
  VOL_DIR=$(dirname "$BR")
  for f in "$IMG_DIR"/*.js "$IMG_DIR"/*.mjs "$IMG_DIR"/*.json; do
    [ -f "$f" ] && cp "$f" "$VOL_DIR/" 2>/dev/null
  done
fi
[ -n "$BR" ] && /opt/hermes/.venv/bin/python /opt/copiloto/patch-bridge.py "$BR" >/dev/null 2>&1 || true

# MCP do Composio — reconciliado a CADA boot a partir da env COMPOSIO_API_KEY.
# O cirurgiao so cola a chave na stack: o script cria o MCP server na conta
# dele, gera a URL com user_id e escreve o bloco mcp_servers no config.yaml.
# Sem a chave, remove a entrada. Nunca derruba o boot (sai 0 sempre).
/opt/hermes/.venv/bin/python /opt/copiloto/composio-setup.py || true

# Numeros de WhatsApp (slots) — reconciliado a CADA boot a partir do
# $DATA/whatsapp/slots.json, que e' a fonte da verdade dos numeros e dos
# grupos de cada um. Aqui e' onde as plataformas extras (whatsapp2,
# whatsapp3...) sao geradas dentro da arvore do Hermes: /opt/hermes e'
# efemero, some quando o container e' recriado, entao precisa ser refeito
# no boot. Na primeira execucao o slots.json nasce do proprio config.yaml,
# preservando o numero e o grupo de uma instalacao que ja estava no ar.
/opt/hermes/.venv/bin/python /opt/copiloto/copiloto_slots.py reconcile || true

# Habilita o WhatsApp SO se ja houver sessao pareada (senao o gateway sai com "not paired").
# Vale para o numero principal, que e' o unico servido pelo plugin oficial
# (os slots extras sao ligados individualmente pelo config.yaml).
# O servidor de QR religa (WHATSAPP_ENABLED=true) apos o pareamento.
if [ -f "$DATA/platforms/whatsapp/session/creds.json" ]; then
  printf true > /run/s6/container_environment/WHATSAPP_ENABLED 2>/dev/null || true
else
  printf false > /run/s6/container_environment/WHATSAPP_ENABLED 2>/dev/null || true
fi

# chown do volume inteiro: o servidor de QR roda como root, entao o que o
# Hermes grava durante o onboarding (.env, gateway_state.json, a sessao do
# WhatsApp) pode nascer root: e o gateway (uid 1000) nao consegue ler.
chown -R "${HERMES_UID:-1000}:${HERMES_GID:-1000}" "$DATA" 2>/dev/null || true
exit 0
