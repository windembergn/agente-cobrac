#!/command/with-contenv sh
# Copiloto — autoconfiguracao no boot (roda depois da base popular /opt/data).
set -e
DATA=/opt/data
CFG="$DATA/config.yaml"
FAB="$DATA/.fabrica"
cd "$DATA" 2>/dev/null || true
mkdir -p "$DATA/whatsapp" "$DATA/skills" "$DATA/dados" "$DATA/copiloto-backups" "$FAB" "$DATA/sites"

# ---------------------------------------------------------------------------
# 1) LINHA DE BASE DE FABRICA — regerada a CADA boot em .fabrica/
#
# O agente pode editar o proprio config.yaml, o SOUL e criar skills. Para existir
# um "restaurar original" que funcione, precisa haver uma copia intocada de como
# o sistema sai da imagem. Ela e' regerada todo boot (e nao so na instalacao) para
# que uma imagem nova traga tambem um original novo — senao "restaurar" devolveria
# o cirurgiao para a versao do dia em que ele instalou, com bugs ja corrigidos.
#
# O secret do painel e' REAPROVEITADO se ja existir: regera-lo a cada boot
# invalidaria a sessao aberta do dashboard a cada atualizacao.
# ---------------------------------------------------------------------------
H=$(/opt/hermes/.venv/bin/python -c "from plugins.dashboard_auth.basic import hash_password; print('H4SH='+hash_password('${DASH_PASS:-TroqueASenha2026}'))" 2>/dev/null | sed -n 's/^H4SH=//p' | tail -1)
# CUIDADO: nada de "[ -z "$S" ] && S=..." aqui. Com set -e, quando a condicao e'
# falsa a lista inteira retorna nao-zero e o script MORRE no meio — foi assim que
# a migracao de persona abaixo deixou de rodar silenciosamente.
le_secret() {
  sed -n 's/^ *secret: *"\{0,1\}\([0-9a-f]\{32,\}\)"\{0,1\} *$/\1/p' "$1" 2>/dev/null | head -1
}
S=$(le_secret "$FAB/config.yaml")
if [ -z "$S" ]; then S=$(le_secret "$CFG"); fi
if [ -z "$S" ]; then S=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'); fi

# ---------------------------------------------------------------------------
# CEREBRO — Claude quando a stack trouxer ANTHROPIC_API_KEY, senao gpt-5.
#
# O modelo exato e' descoberto perguntando a propria API (o catalogo muda mais
# rapido do que a imagem e' reconstruida). O script sai 0 sempre e imprime
# duas linhas provider=/default=; o motivo vai para o log.
# ---------------------------------------------------------------------------
ESCOLHA=$(/opt/hermes/.venv/bin/python /opt/copiloto/escolher-modelo.py 2>>"$DATA/modelo-setup.log")
MODEL_PROVIDER=$(echo "$ESCOLHA" | sed -n 's/^provider=//p' | tail -1)
MODEL_DEFAULT=$(echo "$ESCOLHA" | sed -n 's/^default=//p' | tail -1)
if [ -z "$MODEL_PROVIDER" ]; then MODEL_PROVIDER=openai-api; fi
if [ -z "$MODEL_DEFAULT" ]; then MODEL_DEFAULT=gpt-5; fi

cat > "$FAB/config.yaml" <<CFG
model:
  provider: $MODEL_PROVIDER
  default: $MODEL_DEFAULT
stt:
  enabled: true
  provider: openai
  openai:
    model: whisper-1
# Modo audio (/voice tts, /voice on) usa a MESMA chave da OpenAI que ja e'
# obrigatoria para o Whisper. Sem este bloco o comando existe, o cirurgiao liga,
# e a resposta continua saindo em texto — sem erro nenhum no grupo.
tts:
  enabled: true
  provider: openai
  openai:
    model: tts-1
approvals:
  mode: smart
dashboard:
  basic_auth:
    username: ${DASH_USER:-admin}
    password_hash: "$H"
    secret: "$S"
plugins:
  enabled:
  - dashboard_auth/basic
platforms:
  whatsapp:
    enabled: true
    dm_policy: disabled
    group_policy: allowlist
    group_allow_from: []
display:
  tool_progress: 'off'
  show_reasoning: false
  interim_assistant_messages: false
  memory_notifications: 'off'
  credits_notices: false
  turn_completion_explainer: false
  # Audio nao passa pelo debounce, entao cada audio abre um turno e o proximo
  # interromperia o anterior, gerando "Interrupting current task" em ingles no
  # grupo. Em steer a mensagem nova entra no turno em andamento, e com o ack
  # desligado isso acontece em silencio. O modo interrupt (default) nao tem
  # knob para silenciar esse aviso.
  busy_input_mode: steer
  busy_steer_ack_enabled: false
  platforms:
    whatsapp:
      tool_progress: 'off'
      show_reasoning: false
      interim_assistant_messages: false
      long_running_notifications: false
      busy_steer_ack_enabled: false
      busy_ack_detail: false
      memory_notifications: 'off'
compression:
  threshold: 0.7
cron:
  wrap_response: false

# Dicas de primeira vez ("First-time tip — ... /busy queue ...") ja marcadas como
# vistas: sao one-time, mas a primeira apareceria no grupo do cirurgiao.
onboarding:
  seen:
    busy_input_prompt: true
    tool_progress_prompt: true
    openclaw_residue_cleanup: true
    profile_build_offered: true
CFG

# --- Persona: decidir a migracao ANTES de sobrescrever a linha de base ---
#
# O SOUL do volume nao e' sobrescrito a cada boot de proposito: e' a persona, e o
# usuario (ou o proprio agente) pode ter editado. Mas isso congelaria uma
# instalacao antiga na persona do dia em que foi instalada — e uma persona velha
# que manda "acionar a equipe tecnica" brigaria com o manual novo, que diz que
# ele se ajusta sozinho. Entao: se a persona viva for IDENTICA a de fabrica
# (ninguem mexeu), ela pode ser atualizada em seguranca.
MIGRAR_SOUL=0
GUARDAR_SOUL=0
if [ -f /opt/copiloto/SOUL.md ] && [ -f "$DATA/SOUL.md" ]; then
  if [ -f "$FAB/SOUL.md" ]; then
    if cmp -s "$DATA/SOUL.md" "$FAB/SOUL.md"; then MIGRAR_SOUL=1; fi
  else
    # Instalacao anterior a existencia da linha de base: nao da pra saber se foi
    # editada. Ate aqui a persona nao era editavel na pratica (o agente recusava
    # e o tutorial nunca pediu), entao migra — mas guarda a anterior como copia
    # de seguranca, para o "desfazer" alcancar.
    MIGRAR_SOUL=1
    GUARDAR_SOUL=1
  fi
fi

# Persona e manual de auto-ajuste tambem entram na linha de base.
[ -f /opt/copiloto/SOUL.md ] && cp /opt/copiloto/SOUL.md "$FAB/SOUL.md" || true
[ -f /opt/copiloto/AGENTE.md ] && cp /opt/copiloto/AGENTE.md "$FAB/CLAUDE.md" || true

if [ "$MIGRAR_SOUL" = "1" ]; then
  if [ "$GUARDAR_SOUL" = "1" ]; then
    B="$DATA/copiloto-backups/$(date +%Y%m%d-%H%M%S)-persona-anterior"
    mkdir -p "$B"
    cp "$DATA/SOUL.md" "$B/SOUL.md" 2>/dev/null || true
    echo "persona anterior, guardada ao atualizar o sistema" > "$B/motivo.txt"
  fi
  cp /opt/copiloto/SOUL.md "$DATA/SOUL.md"
fi

# ---------------------------------------------------------------------------
# 2) PRIMEIRO BOOT — instala a linha de base como estado vivo
# ---------------------------------------------------------------------------
if [ ! -f "$DATA/.copiloto_configured" ]; then
  cp "$FAB/config.yaml" "$CFG"
  [ -f "$FAB/SOUL.md" ] && cp "$FAB/SOUL.md" "$DATA/SOUL.md" || true
  touch "$DATA/.copiloto_configured"
fi

# Quais skills ja vinham prontas no sistema. O "restaurar original" e as copias
# de seguranca usam essa lista para mexer SO nas que o agente criar (as nativas
# sao ~8,5 MB e nao tem por que versionar).
#
# FORA do bloco de primeiro boot de proposito: uma instalacao que ja existia nao
# tem essa lista, e sem ela TODA skill nativa passaria por "criada pelo agente" —
# o restaurar original apagaria as 14 que vem prontas.
if [ ! -s "$FAB/skills_originais.txt" ]; then
  ls -1 "$DATA/skills" 2>/dev/null > "$FAB/skills_originais.txt" || true
fi
# A habilidade de publicar site vem da imagem, nao foi o agente que criou: sem
# esta linha, uma instalacao antiga (cuja lista nasceu antes dela existir) a
# trataria como "criada pelo agente" e o restaurar original a apagaria.
if ! grep -qx "publicar-site" "$FAB/skills_originais.txt" 2>/dev/null; then
  echo "publicar-site" >> "$FAB/skills_originais.txt"
fi

# ---------------------------------------------------------------------------
# 3) MANUAL DE AUTO-AJUSTE — atualizado a CADA boot
#
# /opt/data/CLAUDE.md e' lido pelo agente a cada conversa e ensina como ele muda
# a si mesmo sem se quebrar. E' documentacao NOSSA, nao personalizacao do
# cirurgiao: se uma instrucao estiver errada, a correcao tem que chegar pela
# imagem. Por isso e' sobrescrito (o SOUL, que e' a persona, nao e').
# ---------------------------------------------------------------------------
[ -f /opt/copiloto/AGENTE.md ] && cp /opt/copiloto/AGENTE.md "$DATA/CLAUDE.md" || true

# ---------------------------------------------------------------------------
# 3b) SITES — kit de design e habilidade de publicar, atualizados a CADA boot
#
# Tudo que o agente escrever em $DATA/sites/<nome>/ fica no ar em
# https://<dominio>/s/<nome> (servido pelo qr_server, que ja tem rota no
# Traefik). Nao precisa de SSH, nao precisa reiniciar nada.
#
# O _kit (CSS + modelos) e a habilidade sao NOSSOS: sobrescrevemos sempre, como
# o CLAUDE.md. Se a pagina sai feia, a correcao chega pela imagem — e' o mesmo
# principio de "ferramenta instalada sem instrucao = agente que diz nao consigo".
# ---------------------------------------------------------------------------
if [ -d /opt/copiloto/site_kit ]; then
  mkdir -p "$DATA/sites/_kit/modelos" "$DATA/sites/_kit/img" "$DATA/skills/publicar-site"
  cp /opt/copiloto/site_kit/base.css "$DATA/sites/_kit/base.css" 2>/dev/null || true
  cp /opt/copiloto/site_kit/kit.js "$DATA/sites/_kit/kit.js" 2>/dev/null || true
  cp /opt/copiloto/site_kit/modelos/*.html "$DATA/sites/_kit/modelos/" 2>/dev/null || true
  cp /opt/copiloto/site_kit/img/* "$DATA/sites/_kit/img/" 2>/dev/null || true
  cp /opt/copiloto/site_kit/SKILL.md "$DATA/skills/publicar-site/SKILL.md" 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 3c) HABILIDADES NOSSAS — atualizadas a CADA boot, como o _kit e o CLAUDE.md
#
# pedido-cirurgia, recurso-glosa, protocolos, rotina-agenda, pesquisa-cientifica,
# automacoes, apresentacao. Sao DOCUMENTACAO NOSSA, nao personalizacao do
# cirurgiao: se a instrucao estiver errada (ou faltando), a correcao tem que
# chegar pela imagem — foi por isso que a apresentacao, semeada so no primeiro
# boot, ficou congelada numa versao antiga em quem ja tinha instalado.
#
# O que o cirurgiao personaliza de verdade e' o SOUL e as skills que o AGENTE
# cria (essas ficam intocadas — nao estao aqui).
# ---------------------------------------------------------------------------
if [ -d /opt/copiloto/skills ]; then
  for d in /opt/copiloto/skills/*/; do
    [ -d "$d" ] || continue
    nome=$(basename "$d")
    mkdir -p "$DATA/skills/$nome"
    cp -r "$d." "$DATA/skills/$nome/" 2>/dev/null || true
    # Vem pronta da imagem, nao foi o agente que criou: sem esta linha o
    # "restaurar original" a trataria como criacao do agente e apagaria.
    grep -qx "$nome" "$FAB/skills_originais.txt" 2>/dev/null || echo "$nome" >> "$FAB/skills_originais.txt"
  done
fi

# ---------------------------------------------------------------------------
# 3d) PAGINAS DE EXEMPLO — vitrine, documento clinico e guia de convenio
#
# Diferente das skills: essas paginas viram conteudo DO CIRURGIAO assim que ele
# instala (troca nome, foto, cor). Entao a regra e' a mesma da persona: se a
# pagina viva for IDENTICA a de fabrica (ninguem editou), atualiza; se ele
# mexeu, nao encosta. Sem isso, uma instalacao antiga nunca receberia a vitrine
# nova nem o exemplo de guia que a apresentacao manda.
# ---------------------------------------------------------------------------
if [ -d /opt/copiloto/sites_padrao ]; then
  mkdir -p "$FAB/sites_padrao"
  for nome in agente-cobrac exemplo-documento exemplo-solicitacao-convenio; do
    ORIG="/opt/copiloto/sites_padrao/$nome"
    [ -d "$ORIG" ] || continue
    VIVO="$DATA/sites/$nome"
    BASE="$FAB/sites_padrao/$nome"
    if [ ! -d "$VIVO" ]; then
      mkdir -p "$VIVO"
      cp -r "$ORIG/." "$VIVO/" 2>/dev/null || true
    elif [ -f "$BASE/index.html" ]; then
      # Ha linha de base: so atualiza se a pagina viva for identica a ela
      # (ninguem editou). Se o cirurgiao mexeu, nao encosta.
      if cmp -s "$VIVO/index.html" "$BASE/index.html"; then
        cp -r "$ORIG/." "$VIVO/" 2>/dev/null || true
      fi
    else
      # Instalacao anterior a existencia desta linha de base: nao da pra saber
      # se foi editada. Mesma decisao que foi tomada para a persona — atualiza,
      # mas guarda a anterior, para o cirurgiao poder voltar. Sem isto, quem ja
      # tinha instalado ficaria PARA SEMPRE com a vitrine antiga: o baseline
      # nasceria igual a imagem nova e nunca mais bateria com a pagina viva.
      B="$DATA/copiloto-backups/$(date +%Y%m%d-%H%M%S)-site-$nome-anterior"
      mkdir -p "$B"
      cp -r "$VIVO/." "$B/" 2>/dev/null || true
      echo "pagina anterior, guardada ao atualizar o sistema" > "$B/motivo.txt"
      cp -r "$ORIG/." "$VIVO/" 2>/dev/null || true
    fi
    rm -rf "$BASE"
    mkdir -p "$BASE"
    cp -r "$ORIG/." "$BASE/" 2>/dev/null || true
  done
fi

# Atalho que o agente usa: /opt/data/copiloto <verbo>
cat > "$DATA/copiloto" <<'SH'
#!/bin/sh
exec /opt/hermes/.venv/bin/python /opt/copiloto/copiloto_self.py "$@"
SH
chmod 755 "$DATA/copiloto"

# ---------------------------------------------------------------------------
# 4) PEDIDO DE RESTAURACAO vindo do painel (botao "Restaurar original")
#
# O painel roda como root e nao pode reiniciar o container; entao ele so deixa
# a bandeira aqui e o restauro acontece no proximo boot, que e' exatamente
# quando o usuario da Update na stack.
# ---------------------------------------------------------------------------
if [ -f "$DATA/.copiloto_restaurar" ]; then
  /opt/hermes/.venv/bin/python /opt/copiloto/copiloto_self.py fabrica --forcado >/dev/null 2>&1 || true
  rm -f "$DATA/.copiloto_restaurar"
fi

# Aplica os patches do bridge (idempotente)
BR=$(find "$DATA/scripts" -name bridge.js 2>/dev/null | head -1)
# O patch e' idempotente, entao um bridge ja patchado no volume ficaria preso na
# versao antiga ao atualizar a imagem. Como o bridge.js da imagem ja vem patchado
# do build, sincroniza o volume com ele (valida antes de trocar; se o node nao
# aprovar, mantem o que esta la e deixa o patch abaixo cuidar).
#
# Sincroniza a PASTA INTEIRA, nao so o bridge.js: o bridge e' dividido em
# modulos (bridge_helpers.js, allowlist.js, ...) e copiar so o principal
# deixa um bridge novo chamando um helper velho — o que quebra o WhatsApp
# no boot com "does not provide an export named ...". node_modules fica de
# fora (e' pesado e o proprio Hermes reinstala quando o package.json muda).
IMG_DIR=/opt/hermes/scripts/whatsapp-bridge
IMG_BR="$IMG_DIR/bridge.js"
if [ -n "$BR" ] && [ -f "$IMG_BR" ] && node --check "$IMG_BR" >/dev/null 2>&1; then
  VOL_DIR=$(dirname "$BR")
  for f in "$IMG_DIR"/*.js "$IMG_DIR"/*.mjs "$IMG_DIR"/*.json; do
    [ -f "$f" ] && cp "$f" "$VOL_DIR/" 2>/dev/null
  done
fi
[ -n "$BR" ] && /opt/hermes/.venv/bin/python /opt/copiloto/patch-bridge.py "$BR" >/dev/null 2>&1 || true

# MCP do Composio — reconciliado a CADA boot a partir da env COMPOSIO_API_KEY.
# O cirurgiao so cola a chave na stack: o script cria o MCP server na conta
# dele, gera a URL com user_id e escreve o bloco mcp_servers no config.yaml.
# Sem a chave, remove a entrada. Nunca derruba o boot (sai 0 sempre).
/opt/hermes/.venv/bin/python /opt/copiloto/composio-setup.py || true

# TTS — acrescentado ao config VIVO quando faltar. O bloco acima so vale para
# quem instala agora; instalacao que ja existia tem config.yaml proprio (ele nao
# e' sobrescrito, e' do cirurgiao) e continuaria com /voice tts mudo. So
# ACRESCENTA se a chave nao existir — quem ja configurou TTS na mao fica como esta.
/opt/hermes/.venv/bin/python - "$CFG" <<'PY' || true
import sys, yaml
caminho = sys.argv[1]
try:
    with open(caminho, encoding="utf-8") as f:
        cfg = yaml.safe_load(f) or {}
except OSError:
    sys.exit(0)
if "tts" in cfg:
    sys.exit(0)
cfg["tts"] = {"enabled": True, "provider": "openai", "openai": {"model": "tts-1"}}
with open(caminho, "w", encoding="utf-8") as f:
    yaml.safe_dump(cfg, f, allow_unicode=True, sort_keys=False)
print("[tts] bloco acrescentado ao config.yaml")
PY

# Cerebro — reconciliado a CADA boot, como o Composio: o config.yaml so nasce
# no primeiro boot, entao sem isto quem ja tinha instalacao no ar colaria a
# ANTHROPIC_API_KEY na stack e continuaria rodando gpt-5 sem entender por que.
/opt/hermes/.venv/bin/python /opt/copiloto/escolher-modelo.py --aplicar \
  "$MODEL_PROVIDER" "$MODEL_DEFAULT" 2>>"$DATA/modelo-setup.log" || true

# Acesso do agente ao servidor (SSH root no host). Ligado por padrao; depende
# do volume /root/.ssh na stack. Desliga com COPILOTO_HOST_SSH=off.
[ -x /opt/copiloto/host-ssh.sh ] && /opt/copiloto/host-ssh.sh || true

# Numeros de WhatsApp (slots) — reconciliado a CADA boot a partir do
# $DATA/whatsapp/slots.json, que e' a fonte da verdade dos numeros e dos
# grupos de cada um. Aqui e' onde as plataformas extras (whatsapp2,
# whatsapp3...) sao geradas dentro da arvore do Hermes: /opt/hermes e'
# efemero, some quando o container e' recriado, entao precisa ser refeito
# no boot. Na primeira execucao o slots.json nasce do proprio config.yaml,
# preservando o numero e o grupo de uma instalacao que ja estava no ar.
/opt/hermes/.venv/bin/python /opt/copiloto/copiloto_slots.py reconcile || true

# Habilita o WhatsApp SO se ja houver sessao pareada (senao o gateway sai com "not paired").
# Vale para o numero principal, que e' o unico servido pelo plugin oficial
# (os slots extras sao ligados individualmente pelo config.yaml).
# O servidor de QR religa (WHATSAPP_ENABLED=true) apos o pareamento.
if [ -f "$DATA/platforms/whatsapp/session/creds.json" ]; then
  printf true > /run/s6/container_environment/WHATSAPP_ENABLED 2>/dev/null || true
else
  printf false > /run/s6/container_environment/WHATSAPP_ENABLED 2>/dev/null || true
fi

# Foto do config JA ASSENTADO (depois do Composio e dos slots reescreverem o
# arquivo). E' contra esta foto que o "status" compara para dizer o que o AGENTE
# mudou — comparar contra .fabrica/config.yaml acusaria como "mudanca do agente"
# a normalizacao que o proprio sistema faz em todo boot.
cp "$CFG" "$FAB/config_aplicado.yaml" 2>/dev/null || true

# chown do volume inteiro: o servidor de QR roda como root, entao o que o
# Hermes grava durante o onboarding (.env, gateway_state.json, a sessao do
# WhatsApp) pode nascer root: e o gateway (uid 1000) nao consegue ler.
chown -R "${HERMES_UID:-1000}:${HERMES_GID:-1000}" "$DATA" 2>/dev/null || true
exit 0
